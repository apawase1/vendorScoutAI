# ---- Gemini (Google AI Studio) ----
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.0-flash

# ---- Run modes ----
# 1 = canned vendor data (reproducible demos), 0 = live google_search grounding
VENDORSCOUT_STUB=1
# 1 = scripted vendor replies (no Twilio needed), 0 = real WhatsApp messaging
VENDORSCOUT_WHATSAPP_STUB=1

# Optional: force the vendor with this contact to rank #1, so a live demo
# always negotiates with a known consenting number. Leave blank to disable.
DEMO_PRIORITY_VENDOR_CONTACT=

# ---- Twilio WhatsApp Sandbox (test number only, not Meta's Business API) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Leave blank on the Sandbox — free-form text works without a Content Template.
# Only needed for a production WhatsApp sender, which requires templates.
TWILIO_CONTENT_SID=
VENDOR_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX
REPLY_TIMEOUT_SECONDS=120
