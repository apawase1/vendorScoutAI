# ---- Gemini (Google AI Studio) ----
GOOGLE_API_KEY=your-google-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.0-flash

# ---- Run modes ----
# 1 = canned vendor data (reproducible demos), 0 = live google_search grounding
VENDORSCOUT_STUB=1
# 1 = scripted vendor replies (no WhatsApp account needed), 0 = real WhatsApp messaging
VENDORSCOUT_WHATSAPP_STUB=1

# Optional: force the vendor with this contact/name to rank #1, so a live
# demo always negotiates with a known, consenting number. Leave blank to
# disable.
DEMO_PRIORITY_VENDOR_CONTACT=
DEMO_PRIORITY_VENDOR_NAME=

# ---- Meta WhatsApp Cloud API ----
# From developers.facebook.com -> your app -> WhatsApp -> API Setup
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Any string you choose; must match what you type into Meta's webhook config
META_VERIFY_TOKEN=
# App Secret from Meta app -> Settings -> Basic. Required to verify inbound
# webhook signatures — without it, anyone who finds the webhook URL could
# inject fake vendor replies. Leave blank only for local dev behind a
# private tunnel.
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
WEBHOOK_PORT=8000
LOG_LEVEL=INFO

# Recipient in plain digits w/ country code
VENDOR_WHATSAPP_TO=91XXXXXXXXXX
REPLY_TIMEOUT_SECONDS=180

# ---- Shared inbox (webhook process -> agent process) ----
# Leave unset for local dev (falls back to a local JSON file — fine for a
# single process). Set this in any deployment where the UI and the webhook
# run as separate instances/containers, or the webhook will receive replies
# the UI process can never see.
REDIS_URL=
